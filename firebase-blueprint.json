{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and care persona settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "accountType": { "type": "string", "enum": ["elderly", "family", "caretaker"] },
        "phone": { "type": "string", "maxLength": 40 },
        "emergencyContact": { "type": "string", "maxLength": 160 },
        "activeCircleId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "accountType", "createdAt", "updatedAt"]
    },
    "MemberPermissions": {
      "title": "MemberPermissions",
      "description": "Granular healthcare access permissions for a Care Circle member.",
      "type": "object",
      "properties": {
        "viewHealthInfo": { "type": "boolean" },
        "viewMedications": { "type": "boolean" },
        "addMedications": { "type": "boolean" },
        "editMedications": { "type": "boolean" },
        "manageAppointments": { "type": "boolean" },
        "viewAdherenceReports": { "type": "boolean" }
      },
      "required": [
        "viewHealthInfo",
        "viewMedications",
        "addMedications",
        "editMedications",
        "manageAppointments",
        "viewAdherenceReports"
      ]
    },
    "CircleInvite": {
      "title": "CircleInvite",
      "description": "Time-limited, email-bound secure invitation for a family member or caretaker.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "invitedEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "invitedRole": { "type": "string", "enum": ["family", "caretaker"] },
        "relation": { "type": "string", "maxLength": 80 },
        "permissions": { "type": "object", "$ref": "#/entities/MemberPermissions" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "acceptedByUid": { "type": "string", "maxLength": 128 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "inviteCode",
        "circleId",
        "circleName",
        "patientName",
        "ownerUid",
        "ownerName",
        "invitedEmail",
        "invitedRole",
        "relation",
        "permissions",
        "status",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "CircleInviteSecret": {
      "title": "CircleInviteSecret",
      "description": "Write-only salted SHA-256 passcode hash for invitation verification.",
      "type": "object",
      "properties": {
        "passcodeHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["passcodeHash", "ownerUid", "createdAt"]
    },
    "CareCircle": {
      "title": "CareCircle",
      "description": "Shared healthcare profile owned by an elderly individual.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patientAge": { "type": "number" },
        "bloodType": { "type": "string", "maxLength": 16 },
        "allergies": { "type": "string", "maxLength": 500 },
        "primaryPhysician": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "patientName", "patientAge", "ownerId", "memberIds", "createdAt", "updatedAt"]
    },
    "CircleMember": {
      "title": "CircleMember",
      "description": "Authorized member entry and individual permissions within a Care Circle.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "maxLength": 160 },
        "memberRole": { "type": "string", "enum": ["patient", "family", "caretaker"] },
        "relation": { "type": "string", "maxLength": 80 },
        "isCoordinator": { "type": "boolean" },
        "permissions": { "type": "object", "$ref": "#/entities/MemberPermissions" },
        "inviteCodeUsed": { "type": "string", "maxLength": 20 },
        "submittedPasscodeHash": { "type": "string", "maxLength": 64 },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "circleId",
        "displayName",
        "email",
        "memberRole",
        "relation",
        "isCoordinator",
        "permissions",
        "inviteCodeUsed",
        "submittedPasscodeHash",
        "joinedAt",
        "updatedAt"
      ]
    },
    "Medication": {
      "title": "Medication",
      "description": "Prescribed or OTC medication schedule item for an elderly patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "dosage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "frequency": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scheduledTimes": { "type": "array" },
        "instructions": { "type": "string", "maxLength": 400 },
        "prescribedBy": { "type": "string", "maxLength": 120 },
        "remainingQuantity": { "type": "number" },
        "refillThreshold": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "name", "dosage", "frequency", "scheduledTimes", "status", "createdByUid", "memberIds", "createdAt", "updatedAt"]
    },
    "MedicationLog": {
      "title": "MedicationLog",
      "description": "Daily medication dose adherence record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "dosage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "scheduledTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "status": { "type": "string", "enum": ["taken", "skipped", "pending"] },
        "notes": { "type": "string", "maxLength": 300 },
        "loggedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "loggedByName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberIds": { "type": "array" },
        "loggedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "medicationId", "medicationName", "dosage", "dateKey", "scheduledTime", "status", "loggedByUid", "loggedByName", "memberIds", "loggedAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled medical appointment and visit preparation notes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "doctorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "specialty": { "type": "string", "maxLength": 100 },
        "clinicName": { "type": "string", "maxLength": 140 },
        "location": { "type": "string", "maxLength": 240 },
        "appointmentDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "appointmentTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "visitType": { "type": "string", "enum": ["in_person", "telehealth", "home_visit"] },
        "prepNotes": { "type": "string", "maxLength": 600 },
        "outcomeNotes": { "type": "string", "maxLength": 800 },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "title", "doctorName", "appointmentDate", "appointmentTime", "visitType", "status", "createdByUid", "memberIds", "createdAt", "updatedAt"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Medical record, lab result, vital sign measurement, or clinical note.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recordType": { "type": "string", "enum": ["vital_sign", "lab_result", "diagnosis", "immunization", "clinical_note"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "recordedDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "providerName": { "type": "string", "maxLength": 120 },
        "metricValue": { "type": "string", "maxLength": 80 },
        "metricUnit": { "type": "string", "maxLength": 40 },
        "summary": { "type": "string", "maxLength": 1200 },
        "flagged": { "type": "boolean" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "recordType", "title", "recordedDate", "flagged", "createdByUid", "memberIds", "createdAt", "updatedAt"]
    },
    "CareRoutine": {
      "title": "CareRoutine",
      "description": "Daily wellness, hydration, mobility, nutrition, or therapy routine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["hydration", "mobility", "nutrition", "sleep", "hygiene", "therapy"] },
        "targetTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "instructions": { "type": "string", "maxLength": 400 },
        "active": { "type": "boolean" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "title", "category", "targetTime", "active", "createdByUid", "memberIds", "createdAt", "updatedAt"]
    },
    "RoutineLog": {
      "title": "RoutineLog",
      "description": "Daily completion record for a healthcare routine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "routineId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "completed": { "type": "boolean" },
        "completedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "completedByName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberIds": { "type": "array" },
        "completedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "routineId", "dateKey", "completed", "completedByUid", "completedByName", "memberIds", "completedAt", "updatedAt"]
    },
    "CareMessage": {
      "title": "CareMessage",
      "description": "Care team communication message inside a Care Circle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["patient", "family", "caretaker"] },
        "category": { "type": "string", "enum": ["update", "alert", "question", "routine_note"] },
        "body": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "urgent": { "type": "boolean" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "senderUid", "senderName", "senderRole", "category", "body", "urgent", "memberIds", "createdAt"]
    },
    "CareNotification": {
      "title": "CareNotification",
      "description": "Real-time care notification alert for members of a Care Circle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "circleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 400 },
        "severity": { "type": "string", "enum": ["info", "warning", "urgent"] },
        "eventType": { "type": "string", "enum": ["medication", "appointment", "message", "record", "member"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "readByUids": { "type": "array" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "circleId", "title", "detail", "severity", "eventType", "createdByUid", "readByUids", "memberIds", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and role settings."
    },
    "/circleInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/CircleInvite" },
      "description": "Time-limited email-bound Care Circle invitations."
    },
    "/circleInvites/{inviteCode}/secret/hash": {
      "schema": { "$ref": "#/entities/CircleInviteSecret" },
      "description": "Write-only salted passcode hash used for invitation validation."
    },
    "/careCircles/{circleId}": {
      "schema": { "$ref": "#/entities/CareCircle" },
      "description": "Elderly individual's healthcare profile and Care Circle root document."
    },
    "/careCircles/{circleId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/CircleMember" },
      "description": "Authorized Care Circle members and individual permission matrices."
    },
    "/careCircles/{circleId}/medications/{medicationId}": {
      "schema": { "$ref": "#/entities/Medication" },
      "description": "Daily medication prescriptions and refill tracking."
    },
    "/careCircles/{circleId}/medicationLogs/{logId}": {
      "schema": { "$ref": "#/entities/MedicationLog" },
      "description": "Daily medication adherence logs."
    },
    "/careCircles/{circleId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Doctor appointments and clinical visit notes."
    },
    "/careCircles/{circleId}/healthRecords/{recordId}": {
      "schema": { "$ref": "#/entities/HealthRecord" },
      "description": "Health records, lab results, vitals, and clinical summaries."
    },
    "/careCircles/{circleId}/routines/{routineId}": {
      "schema": { "$ref": "#/entities/CareRoutine" },
      "description": "Daily elderly healthcare routines."
    },
    "/careCircles/{circleId}/routineLogs/{logId}": {
      "schema": { "$ref": "#/entities/RoutineLog" },
      "description": "Daily routine completion records."
    },
    "/careCircles/{circleId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/CareMessage" },
      "description": "Care team messaging stream."
    },
    "/careCircles/{circleId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/CareNotification" },
      "description": "Care Circle event notifications."
    }
  }
}
